  "license": "MIT",
  "bugs": {
    "url": "https://github.com/date-js/clever-date/issues"
  },
  "homepage": "https://github.com/date-js/clever-date#readme",
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "ts-loader": "^9.2.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.41.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.0.0"
  },
  "dependencies": {
    "@date-js/date-formatter": "^2.0.1"
  }
